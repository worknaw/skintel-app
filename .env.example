EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Skin Scan uses Gemini through the Supabase Edge Function. No client-side AI
# provider or model endpoint is configurable.

# Required only when building Android with the delivery-address map enabled.
# Restrict this key in Google Cloud to Android app com.justtttlll.myapp and its signing SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=

# Gemini key belongs in Supabase Edge Function secrets as GEMINI_API_KEY.
