{
  "expo": {
    "name": "SkinCycle",
    "slug": "skin-cycle",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "icon": "./assets/images/icon.png",
    "scheme": "skincycle",
    "userInterfaceStyle": "automatic",
    "android": {
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.justtttlll.myapp"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "อนุญาตให้ SkinCycle ใช้กล้องเพื่อทดลองสแกนผิว",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "อนุญาตให้ SkinCycle เข้าถึงรูปภาพเพื่ออัปโหลดสลิปการชำระเงิน",
          "cameraPermission": "อนุญาตให้ SkinCycle ใช้กล้องเพื่อถ่ายสลิปการชำระเงิน",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "อนุญาตให้ SkinCycle ใช้ตำแหน่งปัจจุบันเพื่อปักหมุดที่อยู่จัดส่ง"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "mapsAvailable": false,
      "router": {},
      "eas": {
        "projectId": "c78f3bb5-6a52-45f6-ac80-49c06a71e818"
      }
    }
  }
}
